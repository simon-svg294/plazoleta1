# Copia este archivo como .env o configura estas variables en tu IDE / sistema.
# No subas el .env real al repositorio.

DB_URL=jdbc:mysql://localhost:3306/plazoleta_db?serverTimezone=America/Bogota&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=cambia_esta_clave

# Clave de firma JWT: minimo 32 caracteres. Genera una propia para produccion.
JWT_SECRET=cambia_esta_clave_por_una_de_al_menos_32_caracteres
JWT_EXPIRATION=3600000

# Opcional: logs de SQL (false en produccion)
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SECURITY_LOG_LEVEL=INFO
